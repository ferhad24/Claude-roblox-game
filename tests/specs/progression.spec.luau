--!nocheck
local H = require("../harness")

return function(T)
	local P = H.require("src/shared/Core/Progression")

	T.describe("Güc və ustalıq", function()
		T.it("ümumi XP düsturu 20×(L−1)×L", function()
			T.expect(P.totalXpFor(1)).toBe(0)
			T.expect(P.totalXpFor(2)).toBe(40)
			T.expect(P.totalXpFor(3)).toBe(120)
			T.expect(P.totalXpFor(20)).toBe(7600)
		end)
		T.it("növbəti səviyyəyə əlavə XP 40×L", function()
			for L = 1, 19 do
				T.expect(P.totalXpFor(L + 1) - P.totalXpFor(L)).toBe(40 * L)
			end
		end)
		T.it("24 + 100 XP güc 3 verir (bölmə 4)", function()
			T.expect(P.levelFor(124)).toBe(3)
			T.expect(P.levelFor(119)).toBe(2)
		end)
		T.it("güc 20-dən yuxarı qalxmır", function()
			T.expect(P.levelFor(1e9)).toBe(20)
		end)
		T.it("güc əlavəsi 1 + 0.025 × (L−1)", function()
			T.expect(P.powerMultiplier(1)).toBeNear(1, 1e-9)
			T.expect(P.powerMultiplier(20)).toBeNear(1.475, 1e-9)
		end)
		T.it("ustalıq xərcləri ardıcıl 5, 10, 15, 20, 25", function()
			T.expect(P.masteryLevel(4)).toBe(0)
			T.expect(P.masteryLevel(5)).toBe(1)
			T.expect(P.masteryLevel(15)).toBe(2)
			T.expect(P.masteryLevel(30)).toBe(3)
			T.expect(P.masteryLevel(50)).toBe(4)
			T.expect(P.masteryLevel(75)).toBe(5)
			T.expect(P.masteryLevel(1000)).toBe(5)
		end)
		T.it("ustalıq iş vaxtını ən çox 10% azaldır", function()
			local base = P.workSeconds(10, 1, 1, 0)
			local best = P.workSeconds(10, 1, 1, 5)
			T.expect(best / base).toBeNear(0.9, 1e-9)
			T.expect(P.workSeconds(10, 1, 1, 1) / base).toBeNear(0.98, 1e-9)
		end)
	end)
end
